rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user roles
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Users can read public profiles, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Admins, Teachers, and Drivers lists are public to read.
    // Writes are restricted to Admins.
    match /(admins|drivers|teachers)/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isRole('Admin');
    }

    // Students list can be read by Admins and Teachers.
    // Writes are restricted to Admins.
    match /students/{studentId} {
        allow read: if request.auth != null && (isRole('Admin') || isRole('Teacher'));
        allow write: if request.auth != null && isRole('Admin');
    }

    // Announcements and Homework can be read by anyone authenticated.
    // Writes are restricted to Admins and Teachers.
    match /(announcements|homework)/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (isRole('Admin') || isRole('Teacher'));
    }

    // Products can be read by anyone authenticated.
    // Writes are restricted to Admins.
    match /products/{productId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isRole('Admin');
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}