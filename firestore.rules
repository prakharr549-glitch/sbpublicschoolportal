rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS collection
    // Allow reading of any user profile by any authenticated user.
    // Allow creation and update only by the user themselves.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
    
    // ANNOUNCEMENTS, ADMINS, DRIVERS, TEACHERS, PRODUCTS collections
    // Allow any authenticated user to read.
    // Deny all writes from the client (should be managed by a backend/admin SDK).
    match /(announcements|admins|drivers|teachers|products)/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // Deny client-side writes for security
    }

    // HOMEWORK collection
    // Allow any authenticated user to read.
    // Deny all writes from the client.
    match /homework/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    
    // STUDENTS collection
    // Allow any authenticated user to read.
    // Deny all writes from the client.
    match /students/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // DRIVER LOCATIONS collection
    // Allow any authenticated user to read any driver's location.
    // Allow a driver to only write to their own location document.
    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // CHATS collection
    match /chats/{chatId} {
      // Allow read/write access to chat metadata only if the user is a member.
      // Allow creation if the user is adding themselves as a member.
      allow read, write: if request.auth != null && resource.data.users.hasAny([request.auth.uid]);
      allow create: if request.auth != null && request.resource.data.users.hasAny([request.auth.uid]);
      
      // MESSAGES subcollection
      match /messages/{messageId} {
        // Allow members of the chat to read and create messages.
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        
        // Prevent users from updating or deleting messages directly.
        allow update, delete: if false;
      }
    }
  }
}
