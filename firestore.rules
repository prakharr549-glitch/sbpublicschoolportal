{
  "rules": {
    "users": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "write": {
        "allow": "if request.auth.uid == userId;"
      }
    },
    "admins": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin';"
      }
    },
    "teachers": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin';"
      }
    },
    "students": {
      "read": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      }
    },
    "drivers": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin';"
      }
    },
    "announcements": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      }
    },
    "homework": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      }
    },
    "results": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin' || request.auth.token.role == 'Teacher';"
      }
    },
    "streams": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin';"
      }
    },
    "products": {
      "read": {
        "allow": "if request.auth != null;"
      },
      "create": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "update": {
        "allow": "if request.auth.token.role == 'Admin';"
      },
      "delete": {
        "allow": "if request.auth.token.role == 'Admin';"
      }
    },
    "orders": {
      "read": {
        "allow": "if request.auth.token.role == 'Admin' || resource.data.userId == request.auth.uid;"
      },
      "create": {
        "allow": "if request.auth != null;"
      }
    },
    "chats": {
      "read": {
        "allow": "if request.auth.uid in resource.data.users;"
      },
      "create": {
        "allow": "if request.auth.uid in request.resource.data.users;"
      },
      "delete": {
        "allow": "if request.auth.uid in resource.data.users;"
      },
      "messages": {
        "read": {
          "allow": "if get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);"
        },
        "create": {
          "allow": "if get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);"
        }
      }
    }
  }
}