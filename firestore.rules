
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'Admin';
    }

    function isTeacher() {
      return isSignedIn() && getRole() == 'Teacher';
    }

    // Default: Deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Can read/write their own profile, Admins can read all
    match /users/{userId} {
      allow read: if isAdmin() || isUser(userId);
      allow create, update: if isUser(userId);
    }
    
    // Public read, admin write collections
    match /admins/{adminId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    match /teachers/{teacherId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    match /drivers/{driverId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    // Students: Read for admins/teachers, write for admins
    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    // Announcements: Public read, admin/teacher write
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
    
    // Homework: Public read, admin/teacher write
    match /homework/{homeworkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
    
    // Results: Public read, admin/teacher write
    match /results/{resultId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // Shop Products: Public read, admin write
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Orders: Admins can read all. Users can read/create their own.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // Streams: Public read, admin write
    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Chats: Only participants can read/write
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
