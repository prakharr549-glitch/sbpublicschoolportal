rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is a participant in a chat
    function isChatParticipant(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Authenticated users can read all user profiles (for starting new chats)
      allow list: if isAuthenticated();
      // Any authenticated user can read any user's profile
      allow read: if isAuthenticated();
      // Only the user themselves can create or update their own profile
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Rules for the 'chats' collection
    match /chats/{chatId} {
      // Allow read and update if the user is a participant
      allow read, update: if isChatParticipant(chatId);
      // Allow create if the user is authenticated and is part of the new chat
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;

      // Rules for the 'messages' subcollection
      match /messages/{messageId} {
        // Allow read and write if the user is a participant in the parent chat
        allow read, write: if isChatParticipant(chatId);
      }
    }

    // Rules for other collections (admins, drivers, teachers, students, etc.)
    match /admins/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /announcements/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /drivers/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /homework/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /products/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /students/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /teachers/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
