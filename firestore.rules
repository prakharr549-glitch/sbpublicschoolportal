rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to read their own document or any document if authenticated (for user list)
      allow read: if isAuthenticated();
      // Allow users to create their own user document upon signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow users to update their own document
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for the 'admins' collection
    match /admins/{adminId} {
      // Only allow authenticated users to read
      allow read: if isAuthenticated();
      // Write access should be restricted, e.g., only by other admins or server-side logic
      allow write: if false; 
    }

    // Rules for the 'drivers' collection
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    // Rules for the 'teachers' collection
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Rules for the 'students' collection
    match /students/{studentId} {
        allow read: if isAuthenticated();
        allow write: if false;
    }
    
    // Rules for the 'announcements' collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
    }
    
    // Rules for the 'homework' collection
    match /homework/{homeworkId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated();
    }

    // Rules for the 'products' collection
    match /products/{productId} {
      allow read: if isAuthenticated();
      // Allow authenticated users to add/edit/delete products
      allow write: if isAuthenticated();
    }
    
    // Rules for the 'chats' collection and 'messages' subcollection
    match /chats/{chatId} {
      // A user can read a chat document if they are a participant
      allow get: if isAuthenticated() && request.auth.uid in resource.data.users;
      
      // A user can list chats they are a part of
      allow list: if isAuthenticated() && request.auth.uid == request.query.where.value[2];

      // A user can create a chat if their UID is in the `users` array of the new document
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      
      // A user can update chat metadata (like last message) if they are a participant
      allow update: if isAuthenticated() && request.auth.uid in resource.data.users;

      // Rules for the 'messages' subcollection within a chat
      match /messages/{messageId} {
        // Allow read/write to messages only if the user is part of the parent chat
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
