
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read all profiles, but only write to their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Public collections are readable by any authenticated user
    match /admins/{docId} {
      allow read: if request.auth != null;
    }
    match /teachers/{docId} {
      allow read: if request.auth != null;
    }
    match /drivers/{docId} {
      allow read: if request.auth != null;
    }
    match /students/{docId} {
        allow read: if request.auth != null;
    }
    match /announcements/{docId} {
      allow read: if request.auth != null;
    }
    match /homework/{docId} {
      allow read: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if request.auth != null;
    }
    
    // Driver locations can be read by anyone authenticated, written only by the driver
    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }

    // Chat collections
    match /chats/{chatId} {
      // Allow read/write access only to members of the chat
      allow read, write: if request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        // Allow read/write only to members of the parent chat
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
