rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Authenticated users can read all user profiles (for chat search, etc.)
    // Users can only create and update their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // ANNOUNCEMENTS
    // Authenticated users can read announcements.
    // Writes should be handled by a trusted backend/admin role.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed by backend/admin
    }

    // HOMEWORK
    // Authenticated users can read homework.
    // Writes should be handled by a trusted backend/teacher role.
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed by backend/teacher
    }
    
    // PRODUCTS
    // Authenticated users can read products.
    // Writes should be handled by a trusted backend/admin role.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed by backend/admin
    }

    // ADMINS, TEACHERS, DRIVERS, STUDENTS
    // These collections contain public-facing contact/list info.
    // Allow any authenticated user to read them.
    // Writes should be handled by a trusted backend/admin role.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
     match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // CHATS
    match /chats/{chatId} {
      // Allow read/write access to chat metadata only if the user is a member.
      allow read, write: if request.auth != null && resource.data.users.hasAny([request.auth.uid]);

      // Allow chat creation if the user is in the 'users' array of the new document.
      allow create: if request.auth != null && request.resource.data.users.hasAny([request.auth.uid]);

      // MESSAGES Subcollection
      match /messages/{messageId} {
        // Allow read/create access to messages only if the user is a member of the parent chat.
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        
        // Ensure the senderId matches the authenticated user's UID when creating a message.
        allow create: if request.resource.data.senderId == request.auth.uid;
        
        // No updates or deletes allowed for messages to maintain chat history.
        allow update, delete: if false;
      }
    }
  }
}
