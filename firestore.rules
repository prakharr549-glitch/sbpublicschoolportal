rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check user roles from their user document
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read public user profiles
      allow read: if request.auth != null;
      // A user can only create or update their own profile
      allow create, update: if request.auth.uid == userId;
    }

    // Rules for role-based collections
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /students/{studentId} {
      // Only Admins and Teachers can read student data
      allow read: if isRole('Admin') || isRole('Teacher');
      // Only Admins can write student data
      allow write: if isRole('Admin');
    }

    // Rules for content collections
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin') || isRole('Teacher');
    }
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin') || isRole('Teacher');
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
  }
}
