rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Publicly readable collections for portal information
    match /admins/{adminId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can write
    }
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /homework/{homeworkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
     match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }


    // Drivers can update their own location, authenticated users can read it.
    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }

    // Rules for Chat
    match /chats/{chatId} {
      // User can read/write chat document if they are a member
      allow read, write: if request.auth != null && resource.data.users[request.auth.uid] == true;

      // Messages can be read/written by chat members
      match /messages/{messageId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users[request.auth.uid] == true;

        // Validation for message fields
        allow create: if request.resource.data.keys().hasAll(['text', 'senderId', 'timestamp', 'deleteAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.timestamp == request.time;
      }
    }
  }
}
