
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // USER PROFILES
    // Allow users to read profiles, and only manage their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // CHATS
    // Allow users to create chats and read/write to chats they are members of.
    match /chats/{chatId} {
      allow read, update: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users;
      allow delete: if false; // Deletion should be handled by a backend flow

      // MESSAGES Subcollection
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow update, delete: if false;
      }
    }

    // ANNOUNCEMENTS
    // Allow authenticated users to read, but not write.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // HOMEWORK
    // Allow authenticated users to read, but not write.
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // SHOP PRODUCTS
    // Allow authenticated users to read, but not write.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // ADMINS
    // Allow authenticated users to read, but not write.
    match /admins/{adminId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // TEACHERS
    // Allow authenticated users to read, but not write.
    match /teachers/{teacherId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    
    // STUDENTS
    // Allow authenticated users to read, but not write.
    match /students/{studentId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // DRIVERS
    // Allow authenticated users to read, but not write.
    match /drivers/{driverId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
  }
}
