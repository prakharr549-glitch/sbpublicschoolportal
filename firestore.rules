{
  "rules": {
    "service cloud.firestore": {
      "match": "/databases/{database}/documents": {

        // Default deny all
        "match": "/{document=**}": {
          "allow": "read, write: if false;"
        },

        // Users can be read by anyone, but only updated by the owner.
        // New users can be created by anyone who is authenticated.
        "match": "/users/{userId}": {
          "allow": "read, create: if request.auth != null;",
          "allow": "update: if request.auth != null && request.auth.uid == userId;"
        },

        // Publicly readable collections that require auth for writes/deletes
        "match": "/(announcements|admins|teachers|drivers|products|homework)/{docId}": {
          "allow": "read: if true;",
          "allow": "create, delete, update: if request.auth != null;"
        },
        
        // Students can only be accessed by authenticated users
        "match": "/students/{studentId}": {
          "allow": "read, create, update, delete: if request.auth != null;"
        },

        // Driver locations can be read by any auth'd user, but only written by the driver themselves.
        "match": "/driverLocations/{driverId}": {
          "allow": "read: if request.auth != null;",
          "allow": "write: if request.auth != null && request.auth.uid == driverId;"
        },

        // Chat rules
        "match": "/chats/{chatId}": {
          // Chat metadata can only be accessed by members
          "allow": "get, list, create: if request.auth != null && request.resource.data.users[request.auth.uid] == true;",
          "allow": "update: if request.auth != null && resource.data.users[request.auth.uid] == true;",
          "allow": "delete: if request.auth != null && resource.data.users[request.auth.uid] == true;",

          // Messages can only be accessed by chat members
          "match": "/messages/{messageId}": {
            "allow": "read, write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users[request.auth.uid] == true;"
          }
        }
      }
    }
  }
}
