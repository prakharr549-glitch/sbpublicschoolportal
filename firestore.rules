
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read public data
    match /announcements/{announcementId} {
      allow get, list: if request.auth != null;
    }

    match /products/{productId} {
      allow get, list: if request.auth != null;
    }
    
    match /admins/{adminId} {
        allow get, list: if request.auth != null;
    }

    match /teachers/{teacherId} {
        allow get, list: if request.auth != null;
    }

    match /drivers/{driverId} {
        allow get, list: if request.auth != null;
    }

    match /students/{studentId} {
        allow get, list: if request.auth != null;
    }
    
    match /homework/{homeworkId} {
        allow get, list: if request.auth != null;
    }

    // Users can read all profiles, but only write to their own
    match /users/{userId} {
      allow get, list: if request.auth != null;
    }

    // Driver location can be read by anyone authenticated, but only written by the driver
    match /driverLocations/{userId} {
      allow get: if request.auth != null;
    }

    // Chat rules
    match /chats/{chatId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.users;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
    }
  }
}
