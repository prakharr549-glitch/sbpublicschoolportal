
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public collections readable by any authenticated user.
    match /admins/{adminId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null; // More specific rules might be needed here in a real app
    }

    match /announcements/{announcementId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /drivers/{driverId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true; // Products can be public
      allow create, update, delete: if request.auth != null;
    }

    match /teachers/{teacherId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Homework can be read by any authenticated user.
    // Writing should be restricted in a real app (e.g., only teachers).
    match /homework/{homeworkId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    
    // Students collection is sensitive.
    // Allow read for any authenticated user, as app logic protects the page.
    // Write access should be highly restricted.
    match /students/{studentId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null;
    }
  }
}
