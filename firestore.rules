
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Allow any authenticated user to read the list of users and individual profiles (needed for chat)
    // Allow users to create/update their OWN profile document only
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // CHATS
    // A user can list chats they are a part of.
    // A user can read a chat document if they are one of the users in the chat.
    // A user can create a chat if their UID is in the `users` array.
    // A user can update a chat (e.g., lastMessage) if they are in the chat.
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;

      // MESSAGES subcollection
      // A user can read/write messages in a chat if they are part of that chat.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
      }
    }

    // ANNOUNCEMENTS, ADMINS, TEACHERS, DRIVERS, STUDENTS, HOMEWORK, PRODUCTS
    // Allow any authenticated user to read data from these collections
    match /announcements/{docId} { allow read: if request.auth != null; }
    match /admins/{docId} { allow read: if request.auth != null; }
    match /teachers/{docId} { allow read: if request.auth != null; }
    match /drivers/{docId} { allow read: if request.auth != null; }
    match /students/{docId} { allow read: if request.auth != null; }
    match /homework/{docId} { allow read: if request.auth != null; }
    match /products/{docId} { allow read: if request.auth != null; }

    // DRIVER LOCATIONS
    // Allow authenticated users to read driver locations.
    // Allow any user to write (drivers will be writing their location).
    match /driverLocations/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
    }
  }
}
