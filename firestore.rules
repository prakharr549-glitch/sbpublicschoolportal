
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    // Authenticated users can read all user profiles (for chat/user lists)
    // A user can only create or update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins, Teachers, Drivers, Students: Read-only for authenticated users
    // Write access should be handled by a secure backend/admin SDK for security.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }

    // Announcements, Homework, Products: Read-only for authenticated users.
    // Write access should be handled by a secure backend/admin SDK.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect this data
    }

    // Driver Locations
    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }

    // Chats collection
    match /chats/{chatId} {
      // Allow read/write on the chat document (metadata) only for members.
      allow read, write: if request.auth != null && request.auth.uid in resource.data.users;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read only for members of the chat.
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        
        // Allow create only for members of the chat.
        // Validate the message content.
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
                       && request.resource.data.senderId == request.auth.uid
                       && request.resource.data.text is string
                       && request.resource.data.text.size() > 0;
        
        // Allow update only for members to update read status.
        allow update: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        
        // Disallow deleting messages from the client.
        allow delete: if false;
      }
    }
  }
}
