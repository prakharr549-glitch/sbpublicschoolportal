rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    // Allow reading all user profiles for chat and user lists
    // Allow users to create and update their own profile
    match /users/{userId} {
      allow list, get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public collections - allow any authenticated user to read
    match /admins/{adminId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /announcements/{announcementId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /drivers/{driverId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /homework/{homeworkId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /products/{productId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /students/{studentId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    match /teachers/{teacherId} {
        allow get, list: if request.auth != null;
        allow write: if false; // Should be managed via a backend
    }
    
    // Driver Locations
    // Any authenticated user can read, but only the driver can write their own location.
    match /driverLocations/{driverId} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == driverId;
    }

    // Chats
    // Members can read/write chat metadata and messages.
    match /chats/{chatId} {
      allow get, update: if request.auth != null && resource.data.users.hasAny([request.auth.uid]);
      allow create: if request.auth != null && request.resource.data.users.hasAny([request.auth.uid]);
      
      match /messages/{messageId} {
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false; // Prevent message editing/deletion for now
      }
    }
  }
}
