rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user has a specific role
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Helper function to check if a user is an Admin or Teacher
    function isAdminOrTeacher() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == 'Admin' || userRole == 'Teacher';
    }
    
    // Users can only read and write their own data.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      // Allow admins to read all user profiles
      allow list, get: if request.auth != null && isRole('Admin');
    }

    // Admins, Teachers, and Drivers lists are readable by any authenticated user,
    // but only writable by Admins.
    match /{collection=admins,teachers,drivers}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isRole('Admin');
    }

    // Students list is only readable by Admins and Teachers, and writable by Admins.
    match /students/{studentId} {
        allow read: if request.auth != null && isAdminOrTeacher();
        allow write: if request.auth != null && isRole('Admin');
    }

    // Announcements, Homework, and Products are readable by any authenticated user,
    // but only writable by Admins or Teachers.
    match /{collection=announcements,homework,products}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdminOrTeacher();
    }
    
    // Chat messages can only be read/written by participants of the chat.
    match /chats/{chatId} {
      // Allow read/write access only to users who are part of the chat.
      allow get, list, update, delete: if request.auth != null && request.auth.uid in resource.data.users;
      // Allow a user to create a chat if they are authenticated and are one of the users in the chat.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;

      match /messages/{messageId} {
        // Inherit the parent's read/create permissions.
         allow list, get: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
         allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
         // Messages cannot be updated or deleted by users.
         allow update, delete: if false;
      }
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
