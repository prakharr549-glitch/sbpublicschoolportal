
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to manage their own user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Allow authenticated users to read public-facing collections
    match /admins/{docId} {
      allow read: if request.auth != null;
    }
    match /teachers/{docId} {
      allow read: if request.auth != null;
    }
    match /drivers/{docId} {
      allow read: if request.auth != null;
    }
    match /students/{docId} {
      allow read: if request.auth != null;
    }
    match /announcements/{docId} {
      allow read: if request.auth != null;
    }
    match /homework/{docId} {
      allow read: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to read driver locations
    match /driverLocations/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == driverId;
    }

    // Secure the chat collection
    match /chats/{chatId} {
      // Only members can read/write chat metadata
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;

      // Rules for the messages subcollection
      match /messages/{messageId} {
        // Only members of the chat can read messages
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        
        // Only members of the chat can create messages, and only as themselves
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
                      && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
