rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    //----------------------------------------------------------------------
    //  Public Collections
    //
    //  These collections are readable by any authenticated user.
    //  Writes should be handled by a secure backend environment.
    //----------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow get, list: if request.auth != null;
    }
    match /products/{productId} {
      allow get, list: if request.auth != null;
    }
    match /admins/{adminId} {
        allow get, list: if request.auth != null;
    }
    match /teachers/{teacherId} {
        allow get, list: if request.auth != null;
    }
    match /students/{studentId} {
        allow get, list: if request.auth != null;
    }
    match /drivers/{driverId} {
        allow get, list: if request.auth != null;
    }
     match /homework/{homeworkId} {
        allow get, list: if request.auth != null;
    }

    //----------------------------------------------------------------------
    //  Users Collection
    //
    //  - Authenticated users can read the list of all users.
    //  - A user can create, update, or delete their own document.
    //----------------------------------------------------------------------
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    //----------------------------------------------------------------------
    //  Chat Collections
    //
    //  - Users can create a chat if they are one of the members.
    //  - Only members of a chat can read/write to it.
    //  - Only members of a chat can read/write to its messages subcollection.
    //----------------------------------------------------------------------
    match /chats/{chatId} {
      allow read, update: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users && request.resource.data.users.size() == 2;

      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
