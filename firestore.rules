rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to check user roles
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isUserAuthenticated() && getUserRole() == 'Admin';
    }

    function isTeacher() {
        return isUser-authenticated() && getUserRole() == 'Teacher';
    }

    function isStudent() {
        return isUser-authenticated() && getUserRole() == 'Student';
    }

    // Users can read/update their own profile, Admins can manage all users.
    match /users/{userId} {
      allow read, update: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isUserAuthenticated();
      allow list: if isAdmin() || isTeacher();
    }

    // Allow Admins to read/write all collections for management purposes.
    // Specific read/write rules for other roles are defined below.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public read for authenticated users, write only for Admins/Teachers
    match /announcements/{announcementId} {
      allow read: if isUserAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // Public read for authenticated users, write only for Admins/Teachers
    match /homework/{homeworkId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin() || isTeacher();
    }

    // Public read for authenticated users, write only for Admins/Teachers
    match /results/{resultId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin() || isTeacher();
    }

    // Public read for authenticated users, write only for Admins
     match /streams/{streamId} {
      allow read: if isUserAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Public read for authenticated users, write only for Admins
    match /products/{productId} {
      allow read: if isUserAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Students can create orders.
    // Students can read their own orders. Admins can read all.
    match /orders/{orderId} {
      allow create: if isStudent();
      allow read: if (isStudent() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
    }

    // Chat documents
    match /chats/{chatId} {
      // Users can read/write chats they are a member of
      allow read, write: if isUserAuthenticated() && request.auth.uid in resource.data.users;
      allow create: if isUserAuthenticated() && request.auth.uid in request.resource.data.users;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isUserAuthenticated() && get(parent).data.users.hasAny([request.auth.uid]);
        allow create: if isUserAuthenticated() && get(parent).data.users.hasAny([request.auth.uid]);
      }
    }
    
    // Admins, Teachers, Students, and Drivers lists - Read for all, Write for Admin
    match /admins/{adminId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
     match /teachers/{teacherId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
     match /students/{studentId} {
        allow read: if isUserAuthenticated() && (isAdmin() || isTeacher());
        allow create, update, delete: if isAdmin();
    }
     match /drivers/{driverId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
  }
}
