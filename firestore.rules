rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write their own user document
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public read for most collections
    match /admins/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    match /announcements/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    match /drivers/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    match /homework/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for teacher/admin role
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    match /students/{docId} {
      allow read: if request.auth != null; // Restricted read
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    match /teachers/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplification, ideally check for admin role
    }
    
    // Driver locations can be read by any authenticated user, but only written by the driver themselves.
    match /driverLocations/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Chat rules
    match /chats/{chatId} {
      // Allow read/write only if the user is a member of the chat
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      
      match /messages/{messageId} {
        // Allow read/write only if the user is a member of the chat
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
