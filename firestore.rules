
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is authenticated.
    function isAuth() {
      return request.auth != null;
    }

    // Admins can do anything.
    match /{path=**} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Any authenticated user can read from these collections. 
    // Write access is handled by more specific rules below.
    match /announcements/{docId} {
      allow read: if isAuth();
    }
    match /products/{docId} {
      allow read: if isAuth();
    }
    match /streams/{docId} {
      allow read: if isAuth();
    }
     match /homework/{docId} {
      allow read: if isAuth();
    }
    match /results/{docId} {
        allow read: if isAuth();
    }

    // Users can manage their own user document.
    match /users/{userId} {
      allow read, update: if isAuth() && request.auth.uid == userId;
      allow list: if isAuth(); // Required for chat to find users.
    }
    
    // Teachers and Admins can manage content.
    match /announcements/{announcementId} {
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Teacher'];
    }
    match /homework/{homeworkId} {
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Teacher'];
    }
    match /results/{resultId} {
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Teacher'];
    }
     match /streams/{streamId} {
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Chat rules: must be a participant to read/write.
    match /chats/{chatId} {
      allow read, delete: if isAuth() && request.auth.uid in resource.data.users;
      allow create: if isAuth() && request.auth.uid in request.resource.data.users;
      
      match /messages/{messageId} {
        allow read, create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }

    // Order rules: only the user who placed the order or an admin can see it.
    match /orders/{orderId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
      allow create: if isAuth();
      allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    // Admins and Teachers can view sensitive lists.
    match /students/{studentId} {
      allow list, read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Teacher'];
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /teachers/{teacherId} {
       allow list, read: if isAuth();
       allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /drivers/{driverId} {
       allow list, read: if isAuth();
       allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    match /admins/{adminId} {
        allow list, read: if isAuth();
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
  }
}
