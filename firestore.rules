rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      // Any authenticated user can read any user's profile (needed for chat lists).
      allow read: if request.auth != null;
      // A user can only create, update, or delete their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow authenticated users to list the users collection.
    match /users {
      allow list: if request.auth != null;
    }

    // Admins
    match /admins/{docId} {
      allow read: if request.auth != null;
    }
    match /admins {
       allow list: if request.auth != null;
    }

    // Teachers
    match /teachers/{docId} {
      allow read: if request.auth != null;
    }
     match /teachers {
       allow list: if request.auth != null;
    }

    // Drivers
    match /drivers/{docId} {
      allow read: if request.auth != null;
    }
     match /drivers {
       allow list: if request.auth != null;
    }

    // Students
    match /students/{docId} {
      allow read: if request.auth != null;
    }
     match /students {
       allow list: if request.auth != null;
    }

    // Announcements
    match /announcements/{docId} {
      allow read: if request.auth != null;
    }
     match /announcements {
       allow list: if request.auth != null;
    }

    // Homework
    match /homework/{docId} {
      allow read: if request.auth != null;
    }
     match /homework {
       allow list: if request.auth != null;
    }

    // Products
    match /products/{docId} {
      allow read: if request.auth != null;
    }
     match /products {
       allow list: if request.auth != null;
    }

    // Chat
    match /chats/{chatId} {
      // Allow read/write access to chat metadata only for members of the chat.
      allow read, write: if request.auth != null && request.auth.uid in resource.data.users;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read/write access to messages only for chat members.
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
     // Allow authenticated users to query the chats collection to find their own chats.
    match /chats {
      allow list: if request.auth != null;
    }
  }
}
