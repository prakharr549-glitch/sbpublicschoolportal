
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only write to their own user document.
    // Any authenticated user can read user profiles (needed for chat, etc.).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == userId;
    }

    // Publicly readable collections for authenticated users.
    // Writes should be handled by a secure backend environment (e.g., Cloud Functions).
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
    }
    match /products/{productId} {
      allow read: if request.auth != null;
    }
    match /admins/{adminId} {
      allow read: if request.auth != null;
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
    }
    match /students/{studentId} {
      allow read: if request.auth != null;
    }
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
    }

    // Chat collections
    match /chats/{chatId} {
      // Allow read/write only if the user is a member of the chat.
      allow read, update, delete: if request.auth.uid in resource.data.users;
      // Allow creation if the user is creating it for themselves.
      allow create: if request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read/write only if the user is a member of the parent chat.
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
    
    // Driver locations can be read by any authenticated user.
    // Only the driver can update their own location.
    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }
  }
}
