
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write to their own user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Allow authenticated users to read public collections
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // Managed server-side
    }

    match /driverLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == driverId;
    }

    // Rules for the 'chats' collection
    match /chats/{chatId} {
      // Allow read and write access only to members of the chat
      allow read, write: if request.auth != null && request.auth.uid in resource.data.users;

      // Rules for the 'messages' subcollection
      match /messages/{messageId} {
        // Allow read access to chat members
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users[request.auth.uid] != null;
        
        // Allow write access to chat members, and validate the message data
        allow create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users[request.auth.uid] != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
      }
    }
  }
}
