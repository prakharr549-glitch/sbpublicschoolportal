
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if isUser(userId);
    }

    // ADMINS, TEACHERS, DRIVERS, ANNOUNCEMENTS, HOMEWORK, PRODUCTS
    // These are managed through password-protected forms, so we can allow client-side writes
    // for authenticated users and rely on the UI-level password for authorization.
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }
    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }
    match /drivers/{driverId} {
      allow read, write: if isAuthenticated();
    }
    match /announcements/{announcementId} {
        allow read, write: if isAuthenticated();
    }
    match /homework/{homeworkId} {
        allow read, write: if isAuthenticated();
    }
    match /products/{productId} {
        allow read, write: if isAuthenticated();
    }
    
    // STUDENTS
    // This collection is also password-protected at the UI level.
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // CHATS
    match /chats/{chatId} {
      // Allow read/update if the user is a participant in the chat
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.users;
      // Allow create if the user is creating a chat with themselves as a participant
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users && request.resource.data.users.size() == 2;
      // Disallow client-side deletion for safety; use a flow instead.
      allow delete: if false;

      // MESSAGES Subcollection
      match /messages/{messageId} {
        // Allow read/write if the user is a participant in the parent chat
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
      }
    }
  }
}
