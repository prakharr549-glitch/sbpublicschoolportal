
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS
    // - Allow users to create their own user document.
    // - Allow authenticated users to read any user's profile (for chat functionality).
    // - Allow users to update their own profile information.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
    }
    
    // ANNOUNCEMENTS
    // - Allow authenticated users to read announcements.
    // - Disallow client-side writes.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }

    // HOMEWORK
    // - Allow authenticated users to read homework.
    // - Disallow client-side writes.
    match /homework/{homeworkId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }

    // ADMINS, TEACHERS, DRIVERS, STUDENTS (Contact Lists)
    // - Allow authenticated users to read contact lists.
    // - Disallow client-side writes.
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }
     match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }
     match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }

    // PRODUCTS (SHOP)
    // - Allow authenticated users to read products.
    // - Disallow client-side writes.
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by admin/backend flows
    }

    // STREAMS
    // - Allow authenticated users to read stream information.
    // - Allow admins to create and delete streams.
    match /streams/{streamId} {
      allow read: if isAuthenticated();
      // Allow create/delete only if user has 'Admin' role.
      // Assumes user document has a 'role' field.
      allow create, delete: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
      allow update: if false;
    }

    // CHAT
    // - Users can only create chats where they are a member.
    // - Users can only read/write to chats they are a member of.
    match /chats/{chatId} {
      // isParticipant function
      function isParticipant() {
        return request.auth.uid in resource.data.users;
      }
       // isNewChatParticipant function
      function isNewChatParticipant() {
        return request.auth.uid in request.resource.data.users;
      }

      allow read, update: if isAuthenticated() && isParticipant();
      allow create: if isAuthenticated() && isNewChatParticipant();
      allow delete: if false; // Deletions handled by backend flow

      // MESSAGES (subcollection of chat)
      // - Users can read and write messages in chats they are a member of.
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && get(parent).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false; // No message editing/deleting from client
      }
    }
    
    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    