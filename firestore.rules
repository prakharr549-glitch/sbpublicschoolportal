
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can manage their own profile, and list other users to start chats
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || getUserRole() == 'Admin';
    }
    match /users/{userId} {
       allow list: if request.auth != null;
    }

    // Admins can manage these lists. Teachers can view them.
    match /admins/{docId} {
      allow read, write: if getUserRole() == 'Admin';
    }
    match /teachers/{docId} {
      allow read, write: if getUserRole() == 'Admin';
      allow read: if getUserRole() == 'Teacher';
    }
     match /drivers/{docId} {
      allow read, write: if getUserRole() == 'Admin';
    }
    
    // Students list is protected, only admins/teachers can view.
    match /students/{docId} {
       allow read: if getUserRole() == 'Admin' || getUserRole() == 'Teacher';
       allow write: if getUserRole() == 'Admin';
    }

    // Public content readable by any authenticated user
    // Write access is restricted to Admins/Teachers
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if getUserRole() == 'Admin' || getUserRole() == 'Teacher';
    }
    match /homework/{docId} {
      allow read: if request.auth != null;
      allow write: if getUserRole() == 'Admin' || getUserRole() == 'Teacher';
    }
     match /results/{docId} {
      allow read: if request.auth != null;
      allow write: if getUserRole() == 'Admin' || getUserRole() == 'Teacher';
    }

    // Streams are readable by all, writeable by Admins
    match /streams/{docId} {
        allow read: if request.auth != null;
        allow write: if getUserRole() == 'Admin';
    }

    // Shop products are readable by all, writeable by Admins
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if getUserRole() == 'Admin';
    }

    // Orders are readable by the user who placed them or by an Admin
    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || getUserRole() == 'Admin';
      allow create: if request.auth != null;
      allow update, delete: if getUserRole() == 'Admin';
    }
    
    // Chat functionality
    match /chats/{chatId} {
      // Allow read/write only if the user is a participant in the chat
      allow read, update, delete: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users;
      
      match /messages/{messageId} {
         // Allow read/write only if the user is a participant in the parent chat
        allow read, create, update, delete: if get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
      }
    }
  }
}
