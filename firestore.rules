rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own user document
      allow create: if isAuthenticated();
      // Users can only read or update their own document
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      // Deletion is not allowed
      allow delete: if false;
    }

    // Rules for the 'admins' collection
    match /admins/{adminId} {
      // Anyone can read the list of admins
      allow read: if true;
       // Only authenticated users can manage admins (for simplicity, can be locked down further)
      allow write: if isAuthenticated();
    }

    // Rules for the 'drivers' collection
    match /drivers/{driverId} {
        // Anyone can read driver info
        allow read: if true;
        // Only authenticated users can manage drivers
        allow write: if isAuthenticated();
    }
    
    // Rules for the 'teachers' collection
    match /teachers/{teacherId} {
        // Anyone can read teacher info
        allow read: if true;
        // Only authenticated users can manage teachers
        allow write: if isAuthenticated();
    }

    // Rules for the 'students' collection
    match /students/{studentId} {
        // Only authenticated users can access student data
        allow read, write: if isAuthenticated();
    }

    // Rules for 'announcements'
    match /announcements/{announcementId} {
      // Anyone can read announcements
      allow read: if true;
      // Only authenticated users can create, update, or delete announcements
      allow write: if isAuthenticated();
    }

    // Rules for 'homework'
    match /homework/{homeworkId} {
        // Anyone can read homework
        allow read: if true;
        // Only authenticated users can manage homework
        allow write: if isAuthenticated();
    }
    
    // Rules for 'products'
    match /products/{productId} {
        // Anyone can read products
        allow read: if true;
        // Only authenticated users can manage products
        allow write: if isAuthenticated();
    }
    
    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
