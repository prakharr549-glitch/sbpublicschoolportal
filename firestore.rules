rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the role of a user from the 'users' collection.
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // By default, deny all reads and writes to all documents.
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and update their own profile information.
    // Allow any authenticated user to list users for starting new chats.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null;
    }
    
    // Admins can manage all user documents.
    match /users/{userId} {
      allow read, write: if getUserRole(request.auth.uid) == 'Admin';
    }

    // Chat collections are only accessible by participants in the chat.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.users;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
    }

    // All authenticated users can read public collections.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
    match /streams/{streamId} {
      allow read: if request.auth != null;
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
    match /results/{resultId} {
        allow read: if request.auth != null;
        allow write: if getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
    }
    match /homework/{homeworkId} {
        allow read: if request.auth != null;
        allow write: if getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
    }
    
    // Orders can be read by the user who placed them or by an Admin.
    // Writes are allowed for authenticated users to place orders.
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || getUserRole(request.auth.uid) == 'Admin');
      allow create: if request.auth != null;
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }

    // Sensitive lists can only be viewed by Admins or Teachers.
    // Only Admins can add, update, or delete from these lists.
    match /admins/{adminId} {
      allow read: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
    match /students/{studentId} {
      allow read: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null && getUserRole(request.auth.uid) in ['Admin', 'Teacher'];
      allow write: if getUserRole(request.auth.uid) == 'Admin';
    }
  }
}
