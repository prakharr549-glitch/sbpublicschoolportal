
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS: 
    // - Authenticated users can read all user profiles (to start chats)
    // - Users can only create and update their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId);
    }
    
    // ADMINS, TEACHERS, DRIVERS, ANNOUNCEMENTS, HOMEWORK:
    // - Allow read for any authenticated user.
    // - Allow write for any authenticated user (simplification for now).
    match /admins/{docId} {
      allow read, write: if isSignedIn();
    }
    match /teachers/{docId} {
      allow read, write: if isSignedIn();
    }
     match /drivers/{docId} {
      allow read, write: if isSignedIn();
    }
    match /announcements/{docId} {
      allow read, write: if isSignedIn();
    }
    match /homework/{docId} {
      allow read, write: if isSignedIn();
    }
    
    // PRODUCTS:
    // - Allow read for any authenticated user.
    // - Allow create, update, delete for any authenticated user (simplification).
    match /products/{productId} {
      allow read, write, delete: if isSignedIn();
    }
    
    // CHATS & MESSAGES:
    // - Users can only read/write chats they are a part of.
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn() && request.auth.uid in resource.data.users;
      
       match /messages/{messageId} {
         allow read, create: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
       }
    }
  }
}
