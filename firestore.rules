
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && userRole() == 'Admin';
    }

    function isTeacher() {
      return isAuth() && (userRole() == 'Teacher' || isAdmin());
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isUser(userId) || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    
    match /students/{studentId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    
    match /drivers/{driverId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    
    match /products/{productId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isTeacher();
    }
    
    match /homework/{homeworkId} {
      allow read: if isAuth();
      allow create, update, delete: if isTeacher();
    }
    
    match /results/{resultId} {
      allow read: if isAuth();
      allow create, update, delete: if isTeacher();
    }

    match /streams/{streamId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == resource.data.userId);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.users;
      
      match /messages/{messageId} {
        allow read, write: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
