
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an Admin
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'Admin';
    }
    
    // Helper function to check if a user is a Teacher
    function isTeacher(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'Teacher';
    }

    // Users can only create/update their own profile. Any authenticated user can view profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Admins: Only Admins can manage the list of administrators. All authenticated users can read.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Drivers: Only Admins can manage drivers. All authenticated users can read.
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Students: Only Admins can manage students. All authenticated users can read.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Teachers: Only Admins can manage teachers. All authenticated users can read.
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Announcements: Only Admins/Teachers can create/delete. All authenticated users can read.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }
    
    // Homework: Only Admins/Teachers can create/delete. All authenticated users can read.
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }
    
    // Results: Only Admins/Teachers can create/delete. All authenticated users can read.
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }

    // Products: Only Admins can manage products. All authenticated users can read.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Streams: Only Admins can manage streams. All authenticated users can read.
    match /streams/{streamId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Chats: Users can only read/write chats they are a member of.
    match /chats/{chatId} {
      allow get, list, create, update: if request.auth != null && request.auth.uid in resource.data.users;
      allow delete: if request.auth != null && isAdmin(request.auth.uid);

      // Messages: Users can only read/write messages in chats they are a member of.
      match /messages/{messageId} {
        allow read, create, update: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
      }
    }
  }
}
