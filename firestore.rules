
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get user role from the 'users' collection
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // Helper function to check if a user is an Admin
    function isAdmin(userId) {
      return getUserRole(userId) == 'Admin';
    }

    // Helper function to check if a user is a Teacher
    function isTeacher(userId) {
      return getUserRole(userId) == 'Teacher';
    }

    // Helper function to check if the requesting user is the owner of the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can manage their own profile.
    // Admins can read all profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    // Admins and Teachers can manage announcements.
    // All authenticated users can read announcements.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }
    
    // Admins and Teachers can manage homework.
    // All authenticated users can read homework.
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }

    // Admins and Teachers can manage results.
    // All authenticated users can read results.
    match /results/{resultId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }
    
    // Admins can manage streams.
    // All authenticated users can read streams.
    match /streams/{streamId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Admins can manage the shop products.
    // All authenticated users can read products.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Admins can read all orders.
    // Students can read their own orders.
    // Authenticated users can create orders for themselves.
    match /orders/{orderId} {
      allow read: if request.auth != null && (isAdmin(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Admins can manage the admins, teachers, drivers, and students lists.
    // Authenticated users with the right permissions can view these lists.
    match /admins/{adminId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    match /teachers/{teacherId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
     match /drivers/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    match /students/{studentId} {
        allow read: if request.auth != null && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Users can only access chats they are a part of.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.users;
      
      // Users can only access messages within a chat they are part of.
      match /messages/{messageId} {
         allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
