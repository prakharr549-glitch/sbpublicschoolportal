rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any authenticated user to read the full list of users
    match /users/{userId} {
      allow list: if request.auth != null;
    }
    
    // Allow authenticated users to write to the homework collection
    match /homework/{homeworkId} {
      allow create, delete: if request.auth != null;
    }

    // Rules for other collections
    match /admins/{adminId} {
      allow read, write, delete: if request.auth != null;
    }
    match /announcements/{announcementId} {
      allow read, write, delete: if request.auth != null;
    }
    match /drivers/{driverId} {
      allow read, write, delete: if request.auth != null;
    }
    match /products/{productId} {
        allow read, create, update, delete: if request.auth != null;
    }
    match /students/{studentId} {
        allow read, write, delete: if request.auth != null;
    }
    match /teachers/{teacherId} {
        allow read, write, delete: if request.auth != null;
    }

    // Fallback rule for any other path - read only for authenticated users
    match /{document=**} {
      allow read: if request.auth != null;
    }
  }
}
