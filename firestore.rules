rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins list can be read by any authenticated user, but not written to.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }

    // Announcements can be read by any authenticated user, but not written to.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }
    
    // Drivers list can be read by any authenticated user, but not written to.
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }

    // Homework can be read by any authenticated user, but not written to.
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }
    
    // Products can be read by any authenticated user, but not written to.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }
    
    // Students list can be read by any authenticated user, but not written to.
    // App-level password provides an additional layer of security.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }

    // Teachers list can be read by any authenticated user, but not written to.
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if false; // Should be managed by a trusted backend/admin role
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
