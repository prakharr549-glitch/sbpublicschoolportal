
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'Admin';
    }

    function isTeacher() {
      return isAuth() && getUserRole() == 'Teacher';
    }
    
    function isManager() {
        return isAdmin() || isTeacher();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can manage their own profile, anyone can read user list for chat
    match /users/{userId} {
      allow list, get: if isAuth();
      allow create, update: if isUser(userId);
    }
    
    // Allow managers to see sensitive lists
    match /admins/{docId} {
      allow read, list, write: if isAdmin();
    }
    
    match /teachers/{docId} {
      allow read, list: if isManager();
      allow write: if isAdmin();
    }
    
    match /drivers/{docId} {
      allow read, list: if isManager();
      allow write: if isAdmin();
    }
    
    match /students/{docId} {
      allow read, list: if isManager();
      allow write: if isAdmin();
    }

    // Public content, readable by any authenticated user
    // Writable only by teachers or admins
    match /announcements/{docId} {
      allow read, list: if isAuth();
      allow write: if isManager();
    }
    
    match /homework/{docId} {
      allow read, list: if isAuth();
      allow write: if isManager();
    }

    match /results/{docId} {
        allow read, list: if isAuth();
        allow write: if isManager();
    }

    match /streams/{docId} {
        allow read, list: if isAuth();
        allow write: if isAdmin();
    }

    match /products/{docId} {
        allow read, list: if isAuth();
        allow write: if isAdmin();
    }

    // Orders can be read by the user who created them or an admin
    match /orders/{orderId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuth();
    }

    // Chat rules
    match /chats/{chatId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.users;
      allow list: if isAuth();
      allow create: if isAuth();

      match /messages/{messageId} {
        allow read, write: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
