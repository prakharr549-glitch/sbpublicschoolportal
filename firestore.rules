
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get user's role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Helper function to check if a user is an Admin
    function isAdmin(userId) {
      return getUserRole(userId) == 'Admin';
    }
    
    // Helper function to check if a user is a Teacher or Admin
    function isTeacherOrAdmin(userId) {
      let role = getUserRole(userId);
      return role == 'Admin' || role == 'Teacher';
    }
    
    // Users can read/write their own profile, Admins can read all.
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin(request.auth.uid);
      allow create: if request.auth.uid != null;
    }
    
    // Admins have full access to their own records. Others can't access.
    match /admins/{adminId} {
        allow read, write: if isAdmin(request.auth.uid);
    }
    
    // Admins/Teachers can read all. Admins can write.
    match /teachers/{teacherId} {
        allow read: if isTeacherOrAdmin(request.auth.uid);
        allow write: if isAdmin(request.auth.uid);
    }
    
    // Admins/Teachers can read all. Admins can write.
    match /students/{studentId} {
        allow read: if isTeacherOrAdmin(request.auth.uid);
        allow write: if isAdmin(request.auth.uid);
    }
    
    // Admins/Teachers can read all. Admins can write.
    match /drivers/{driverId} {
        allow read: if isTeacherOrAdmin(request.auth.uid);
        allow write: if isAdmin(request.auth.uid);
    }

    // Authenticated users can read. Admins/Teachers can write.
    match /announcements/{announcementId} {
        allow read: if request.auth.uid != null;
        allow write: if isTeacherOrAdmin(request.auth.uid);
    }
    
    // Authenticated users can read. Admins/Teachers can write.
    match /homework/{homeworkId} {
        allow read: if request.auth.uid != null;
        allow write: if isTeacherOrAdmin(request.auth.uid);
    }
    
    // Authenticated users can read. Admins can write.
    match /streams/{streamId} {
        allow read: if request.auth.uid != null;
        allow write: if isAdmin(request.auth.uid);
    }
    
    // Authenticated users can read. Admins/Teachers can write.
    match /results/{resultId} {
        allow read: if request.auth.uid != null;
        allow write: if isTeacherOrAdmin(request.auth.uid);
    }
    
    // Authenticated users can read. Admins can write.
    match /products/{productId} {
        allow read: if request.auth.uid != null;
        allow write: if isAdmin(request.auth.uid);
    }

    // Orders: Admins can read all. Users can create, and read their own.
    match /orders/{orderId} {
        allow read: if isAdmin(request.auth.uid) || resource.data.userId == request.auth.uid;
        allow create: if request.auth.uid != null;
        allow write: if isAdmin(request.auth.uid);
    }
    
    // Chat: Users can only access chats they are a member of.
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
