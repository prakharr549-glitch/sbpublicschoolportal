rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions to check user roles
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isUserAuthenticated() && getUserRole(request.auth.uid) == 'Admin';
    }
    
    function isTeacher() {
        return isUserAuthenticated() && getUserRole(request.auth.uid) == 'Teacher';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can manage their own profile and list other users for chat
    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow update: if request.auth.uid == userId;
      allow create: if isUserAuthenticated();
    }
    
    match /admins/{adminId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
    
    match /teachers/{teacherId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
    
    match /drivers/{driverId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
    
    match /students/{studentId} {
        allow read: if isAdmin() || isTeacher();
        allow create, update, delete: if isAdmin();
    }
    
    match /announcements/{announcementId} {
      allow read: if isUserAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    
    match /homework/{homeworkId} {
      allow read: if isUserAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /results/{resultId} {
        allow read: if isUserAuthenticated();
        allow create, delete: if isAdmin() || isTeacher();
    }

    match /streams/{streamId} {
        allow read: if isUserAuthenticated();
        allow create, delete: if isAdmin();
    }
    
    match /products/{productId} {
        allow read: if isUserAuthenticated();
        allow create, update, delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.userId;
      allow create: if isUserAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, create, update: if isUserAuthenticated() && request.auth.uid in resource.data.users;
      allow delete: if isUserAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      
      match /messages/{messageId} {
        allow read, create, update: if isUserAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow delete: if isAdmin();
      }
    }
  }
}
