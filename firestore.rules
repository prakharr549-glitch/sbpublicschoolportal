
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'Admin';
    }

    function isTeacher() {
      return isAuth() && request.auth.token.role == 'Teacher';
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins have god-mode access
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // USERS
    // All authenticated users can see the list of users (for chat)
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, update: if isAuth() && request.auth.uid == userId;
      allow list: if isAuth();
    }

    // CHATS
    // Users can only read/write chats they are a part of
    match /chats/{chatId} {
      allow read, write: if isAuth() && resource.data.users.hasAny([request.auth.uid]);
      match /messages/{messageId} {
        allow read, write: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
      }
    }

    // Public collections (read-only for non-admins/teachers)
    match /admins/{adminId} {
      allow read: if isAuth();
    }
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isTeacher();
    }
    match /drivers/{driverId} {
      allow read: if isAuth();
    }
     match /homework/{homeworkId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isTeacher();
    }
    match /products/{productId} {
      allow read: if isAuth();
    }
    match /results/{resultId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isTeacher();
    }
    match /streams/{streamId} {
      allow read: if isAuth();
    }
    match /students/{studentId} {
      allow read: if isAuth();
    }
    match /teachers/{teacherId} {
      allow read: if isAuth();
    }
    match /orders/{orderId} {
        allow read: if isAuth() && resource.data.userId == request.auth.uid;
        allow create: if isAuth();
    }
  }
}
