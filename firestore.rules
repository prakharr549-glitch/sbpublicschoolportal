
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated users can read public collections
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Make admin collection write-only from backend
    }
    match /teachers/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
     match /drivers/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /announcements/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    match /homework/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
     match /products/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // Students collection is protected and should have specific rules
    // For now, only allow authenticated users to read.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if false; // Disallow client-side writes for now
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
