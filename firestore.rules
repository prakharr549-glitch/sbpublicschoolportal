rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if a user is a participant in a chat
    function isChatParticipant(chatId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for starting new chats)
      allow read: if isAuthenticated();
      // A user can only write to their own document
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Rules for the 'chats' collection
    match /chats/{chatId} {
      // Allow read, update if the user is in the 'users' array of the chat
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.users;
      // Allow create if the user's own UID is in the new chat's 'users' array
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      
      // Rules for the 'messages' subcollection
      match /messages/{messageId} {
        // Allow read, write if the user is a participant of the parent chat
        allow read, write: if isChatParticipant(chatId);
      }
    }

    // Rules for other collections (admins, drivers, teachers, etc.)
    // These collections are currently configured for public read but write is denied.
    // This can be adjusted based on specific application requirements.
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false; // Example: lock down writes
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    match /homework/{homeworkId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
        allow read: if true;
        allow write, delete: if false; 
    }

    // Student data is sensitive, so access is restricted.
    // Only authenticated users should be able to read.
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
