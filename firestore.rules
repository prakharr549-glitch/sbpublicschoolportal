
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if a user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if user has a specific role
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isTeacher() {
      return hasRole('Teacher');
    }

    function isAdmin() {
      return hasRole('Admin');
    }
    
    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read any user's profile (for chat purposes)
      allow read: if isAuthenticated();
      // A user can create their own profile document
      allow create: if isOwner(userId);
      // A user can only update their own profile
      allow update: if isOwner(userId);
      // Users cannot delete their own profiles
      allow delete: if false;
    }

    // Rules for 'chats' and subcollections
    match /chats/{chatId} {
      // Users can only read/write to chats they are a part of
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.users;
      // Users can create a chat if they are one of the members in the chat
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
       // Disallow client-side deletion. Deletions should be handled by a backend flow.
      allow delete: if false;

      match /messages/{messageId} {
        // Users can read messages in chats they are part of
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        // Users can create messages in chats they are part of
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]);
        // Disallow client-side updates/deletes of messages.
        allow update, delete: if false;
      }
    }
    
    // Rules for 'products' collection
    match /products/{productId} {
      // Anyone authenticated can view products
      allow read: if isAuthenticated();
      // Only Admins can create, update, or delete products (via backend flow for delete)
      allow write: if isAdmin();
      // Allow create/update for admins
      allow create, update: if isTeacherOrAdmin();
       // Disallow client-side deletion. Deletions should be handled by a backend flow.
      allow delete: if false;
    }
    
     // Rules for 'announcements' collection
    match /announcements/{announcementId} {
      // Anyone authenticated can view announcements
      allow read: if isAuthenticated();
      // Only Admins or Teachers can create/delete announcements
      allow write: if isTeacherOrAdmin();
    }

    // Rules for 'admins' collection
    match /admins/{adminId} {
      // Anyone can read the admin list
      allow read: if isAuthenticated();
      // Only Admins can add/delete other admins
      allow write: if isAdmin();
    }
    
    // Rules for 'teachers' collection
    match /teachers/{teacherId} {
      // Anyone can read the teacher list
      allow read: if isAuthenticated();
      // Only Admins can add/delete teachers
      allow write: if isAdmin();
    }
    
     // Rules for 'drivers' collection
    match /drivers/{driverId} {
      // Anyone can read the driver list
      allow read: if isAuthenticated();
      // Only Admins can add/delete drivers
      allow write: if isAdmin();
    }
    
    // Rules for 'homework' collection
    match /homework/{homeworkId} {
      // Anyone authenticated can read homework
      allow read: if isAuthenticated();
      // Only Admins or Teachers can create/delete homework
      allow write: if isTeacherOrAdmin();
    }

    // Rules for 'students' collection (assuming this is sensitive)
    match /students/{studentId} {
      // Only Admins and Teachers can read/write student data
      allow read, write: if isTeacherOrAdmin();
    }
    
    // Rules for 'streams' collection
    match /streams/{streamId} {
        // All authenticated users can view the stream list
        allow read: if isAuthenticated();
        // Only Admins can create, update, or delete streams
        allow write: if isAdmin();
    }

    // Rules for the new 'results' collection
    match /results/{resultId} {
      // All authenticated users can read/list results
      allow read: if isAuthenticated();
      // Only Admins and Teachers can create/upload new results
      allow create: if isTeacherOrAdmin();
      // Only Admins and Teachers can delete results
      allow delete: if isTeacherOrAdmin();
      // Disallow client-side updates
      allow update: if false;
    }
  }
}
