rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    function isTeacher() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Teacher';
    }
    
    function isTeacherOrAdmin() {
        return isAdmin() || isTeacher();
    }

    // Admins can read/write anything for administrative purposes
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // All authenticated users can see user profiles (for chat, etc.)
      allow get: if isAuth();
      // All authenticated users can list user profiles (for starting new chats)
      allow list: if isAuth();
      // Users can only create their own user document
      allow create: if isOwner(userId);
      // Users can only update their own profile
      allow update: if isOwner(userId);
      // Users cannot delete their own accounts from the client
      allow delete: if false;
    }

    // Chats collection
    match /chats/{chatId} {
      // Users can only read chats they are a part of
      allow get, list: if isAuth() && request.auth.uid in resource.data.users;
      // Users can only create chats they are a part of
      allow create: if isAuth() && request.auth.uid in request.resource.data.users;
      // Users can update chats they are part of (e.g., last message)
      allow update: if isAuth() && request.auth.uid in resource.data.users;

      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages in chats they are part of
        allow read, write, create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow delete, update: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }

    // Admins, Teachers, Students, Drivers (publicly readable lists)
    match /admins/{adminId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    match /drivers/{driverId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    
    // Announcements (readable by all, writable by admin/teacher)
    match /announcements/{announcementId} {
        allow read: if isAuth();
        allow create, update, delete: if isTeacherOrAdmin();
    }
    
    // Homework (readable by all, writable by admin/teacher)
    match /homework/{homeworkId} {
        allow read: if isAuth();
        allow create, update, delete: if isTeacherOrAdmin();
    }
    
    // Results (readable by all, writable by admin/teacher)
    match /results/{resultId} {
        allow read: if isAuth();
        allow create, update, delete: if isTeacherOrAdmin();
    }
    
    // Streams (readable by all, writable by admin)
    match /streams/{streamId} {
        allow read: if isAuth();
        allow create, update, delete: if isAdmin();
    }

    // Products (readable by all, writable by admin)
    match /products/{productId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Admins can read all orders, users can read their own
      allow read: if isAdmin() || (isAuth() && resource.data.phoneNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone);
      // Authenticated users can create orders
      allow create: if isAuth();
      // No one can update or delete orders from the client
      allow update, delete: if false;
    }
  }
}
