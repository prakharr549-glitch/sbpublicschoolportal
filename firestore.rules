
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user has a specific role
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Helper function to check if a user is an Admin
    function isAdmin() {
      return isRole('Admin');
    }
    
    // Helper function to check if a user is a Teacher
    function isTeacher() {
      return isRole('Teacher');
    }

    // `users` collection: Users can read/write their own document. Admins can read any.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // `admins`, `teachers`, `drivers`, `students` collections: Read-only for authenticated users, writeable only by admins.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /students/{studentId} {
      // Only Admins and Teachers should see the full student list
      allow list: if isAdmin() || isTeacher();
      allow get: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    // `announcements`, `homework`, `streams`, `results` collections: Read-only for authenticated, writeable by Admin/Teacher.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /streams/{streamId} {
       allow read: if request.auth != null;
       allow write: if isAdmin();
    }
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // `products`: Read-only for authenticated, writeable by Admin.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // `orders` collection: Admins can read all, users can read their own. Authenticated users can create.
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      // No updates or deletes from client side for now.
      allow update, delete: if false; 
    }

    // `chats` collection: Granular access control for chat messages.
    match /chats/{chatId} {
      // Allow read/write if the user is part of the chat
      allow read, write: if request.auth.uid in resource.data.users;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow read/write if the user is part of the parent chat
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
