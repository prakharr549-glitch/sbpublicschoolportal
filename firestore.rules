
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Allow users to read all profiles (for chat, etc.)
    // Allow users to create and update their OWN profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }
    
    // ANNOUNCEMENTS
    // Allow any authenticated user to read announcements
    // Disallow client-side writes
    match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    
    // ADMINS
    // Allow any authenticated user to read admin info
    // Disallow client-side writes
    match /admins/{adminId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // TEACHERS
    // Allow any authenticated user to read teacher info
    // Disallow client-side writes
    match /teachers/{teacherId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    
    // DRIVERS
    // Allow any authenticated user to read driver info
    // Disallow client-side writes
    match /drivers/{driverId} {
        allow read: if request.auth != null;
        allow write: if false;
    }
    
    // STUDENTS
    // Allow any authenticated user to read student info
    // Disallow client-side writes
    match /students/{studentId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // HOMEWORK
    // Allow any authenticated user to read homework
    // Disallow client-side writes
    match /homework/{homeworkId} {
        allow read: if request.auth != null;
        allow write: if false;
    }

    // PRODUCTS
    // Allow any authenticated user to read products
    // Disallow client-side writes
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // CHATS
    match /chats/{chatId} {
      // Allow read/write only if the user is a member of the chat
      allow read, write: if request.auth.uid in resource.data.users;

      // New chats can be created if the requesting user is in the 'users' array
      allow create: if request.auth.uid in request.resource.data.users;

      // MESSAGES subcollection
      match /messages/{messageId} {
        // Allow read only if user is a member of the parent chat
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        
        // Allow create only if user is a member and the senderId is their own UID
        allow create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
                      && request.resource.data.senderId == request.auth.uid;
                      
        // Disallow updates and deletes from client
        allow update, delete: if false;
      }
    }
  }
}
