
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user has a specific role
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Helper function to check if a user has any of the specified roles
    function isRoleIn(roles) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole in roles;
    }
    
    // Admins have god mode
    match /{document=**} {
      allow read, write: if isRole('Admin');
    }

    // Users collection
    match /users/{userId} {
      // Allow users to read the list of users (for chat)
      allow list: if request.auth != null;
      // Allow users to read their own profile
      allow get: if request.auth.uid == userId;
      // Allow users to update their own profile
      allow update: if request.auth.uid == userId;
       // Allow users to create their own user document on signup
      allow create: if request.auth.uid == userId;
    }
    
    // Chats collection
    match /chats/{chatId} {
        // Users can only access chats they are a part of
        allow get, update, delete: if request.auth.uid in resource.data.users;
        allow create: if request.auth.uid in request.resource.data.users;

        // Messages subcollection
        match /messages/{messageId} {
            allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
            allow update, delete: if false; // Messages are immutable
        }
    }
    
    // Admins, Teachers, Drivers, Students
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if isRole('Admin');
    }
    match /students/{studentId} {
      allow read: if isRoleIn(['Admin', 'Teacher']);
      allow write: if isRoleIn(['Admin', 'Teacher']);
    }
    
    // Announcements and Homework
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRoleIn(['Admin', 'Teacher']);
    }
    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRoleIn(['Admin', 'Teacher']);
    }

    // Results
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRoleIn(['Admin', 'Teacher']);
    }
    
    // Live Streams
    match /streams/{streamId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isRole('Admin');
    }

    // Shop and Orders
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRole('Admin');
    }
    match /orders/{orderId} {
      // Users can only read their own orders
      allow get: if request.auth.uid == resource.data.userId || isRole('Admin');
      allow list: if isRole('Admin');
      // Any authenticated user can create an order
      allow create: if request.auth != null;
      // Only admins can update order status
      allow update: if isRole('Admin');
    }

  }
}
